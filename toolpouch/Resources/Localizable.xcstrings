    "Changing either dimension updates the other and preserves the original proportions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ändern einer Abmessung wird die andere angepasst, um die ursprünglichen Proportionen zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar una dimensión se ajusta la otra y se conservan las proporciones originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier une dimension ajuste l’autre en conservant les proportions d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificando una dimensione, l’altra viene aggiornata mantenendo le proporzioni originali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片方の寸法を変更すると、元の縦横比を維持してもう片方が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한쪽 크기를 변경하면 다른 쪽도 업데이트되어 원본 비율을 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana jednego wymiaru aktualizuje drugi i zachowuje pierwotne proporcje."
          }
        },
