    "Thermal pressure is critical. Stop demanding work and allow the device to cool." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die thermische Belastung ist kritisch. Beende anspruchsvolle Aufgaben und lasse das Gerät abkühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presión térmica es crítica. Detén las tareas exigentes y deja que el dispositivo se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrainte thermique est critique. Arrêtez les tâches intensives et laissez l’appareil refroidir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico termico è critico. Interrompi le attività impegnative e lascia raffreddare il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱負荷が危険な状態です。負荷の高い作業を中止し、デバイスを冷ましてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 부담이 위험 수준입니다. 부하가 큰 작업을 중단하고 기기를 식히세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie termiczne jest krytyczne. Przerwij wymagające zadania i pozwól urządzeniu ostygnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pressão térmica está crítica. Interrompa tarefas exigentes e deixe o dispositivo esfriar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热压力已达危急水平。请停止高负载任务，让设备冷却。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散熱壓力已達危急程度。請停止高負載工作，讓裝置冷卻。"
          }
        }
      }
    },
    "Thermal pressure is high. The system may reduce performance to cool down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die thermische Belastung ist hoch. Das System könnte die Leistung reduzieren, um abzukühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presión térmica es alta. El sistema puede reducir el rendimiento para enfriarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrainte thermique est élevée. Le système peut réduire ses performances pour refroidir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico termico è elevato. Il sistema potrebbe ridurre le prestazioni per raffreddarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱負荷が高くなっています。冷却のためにシステムの性能が制限される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 부담이 높습니다. 온도를 낮추기 위해 시스템 성능이 줄어들 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie termiczne jest wysokie. System może ograniczyć wydajność, aby obniżyć temperaturę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pressão térmica está alta. O sistema pode reduzir o desempenho para esfriar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热压力较高。系统可能降低性能以降温。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散熱壓力偏高。系統可能降低效能以降溫。"
          }
        }
      }
