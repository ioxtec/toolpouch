    "When disabled, Network Info shows the latest saved snapshot until you refresh it manually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, zeigt die Netzwerkinformation die letzte gespeicherte Momentaufnahme, bis du manuell aktualisierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se desactiva, la información de red muestra la última instantánea guardada hasta que actualices manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est désactivée, les informations réseau affichent le dernier instantané enregistré jusqu’à une actualisation manuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, Info rete mostra l’ultima rilevazione salvata fino all’aggiornamento manuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合、ネットワーク情報には手動で更新するまで最後に保存した記録が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비활성화하면 네트워크 정보는 수동으로 새로 고칠 때까지 마지막으로 저장한 스냅샷을 표시합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wyłączeniu informacje o sieci pokazują ostatni zapis aż do ręcznego odświeżenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, Informações de rede mostra o último registro salvo até você atualizar manualmente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，网络信息会显示最近保存的快照，直到您手动刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，網路資訊會顯示最近儲存的快照，直到您手動重新整理。"
          }
        }
      }
    },
    "While picking, click to select a pixel or press Escape to cancel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke während der Auswahl auf einen Pixel oder drücke Escape zum Abbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la selección, haz clic para elegir un píxel o pulsa Escape para cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la sélection, cliquez pour choisir un pixel ou appuyez sur Échap pour annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la selezione, fai clic su un pixel o premi Esc per annullare."
