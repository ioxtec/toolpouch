        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 중에 클릭하여 픽셀을 선택하거나 Escape를 눌러 취소하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
