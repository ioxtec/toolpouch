    "Samples are stored locally on this device. iPhone and Apple Watch collection pauses whenever the system suspends the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messwerte werden lokal auf diesem Gerät gespeichert. Auf iPhone und Apple Watch pausiert die Erfassung, wenn das System die App anhält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las muestras se guardan localmente en este dispositivo. En iPhone y Apple Watch, la recopilación se pausa cuando el sistema suspende la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures sont stockées localement sur cet appareil. Sur iPhone et Apple Watch, la collecte est interrompue lorsque le système suspend l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campioni vengono salvati localmente sul dispositivo. Su iPhone e Apple Watch la raccolta si interrompe quando il sistema sospende l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルはこのデバイスにローカル保存されます。iPhoneとApple Watchでは、システムがアプリを中断すると収集も一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샘플은 이 기기에 로컬로 저장됩니다. iPhone 및 Apple Watch에서는 시스템이 앱을 일시 정지할 때 수집도 중단됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbki są zapisywane lokalnie na tym urządzeniu. Na iPhonie i Apple Watch zbieranie danych jest wstrzymywane, gdy system usypia aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As amostras são salvas localmente neste dispositivo. No iPhone e Apple Watch, a coleta pausa quando o sistema suspende o app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "样本存储在此设备本机。系统暂停应用时，iPhone 和 Apple Watch 上的采集也会暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樣本儲存於此裝置本機。系統暫停 App 時，iPhone 與 Apple Watch 上的收集也會暫停。"
          }
        }
      }
    },
