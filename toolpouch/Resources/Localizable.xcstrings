    "Anyone with this private key may be able to access your systems. Clear the clipboard after use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer diesen privaten Schlüssel besitzt, kann möglicherweise auf deine Systeme zugreifen. Leere nach Gebrauch die Zwischenablage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga esta clave privada podría acceder a tus sistemas. Vacía el portapapeles después de usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne possédant cette clé privée pourrait accéder à vos systèmes. Videz le presse-papiers après utilisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque disponga di questa chiave privata potrebbe accedere ai tuoi sistemi. Svuota gli appunti dopo l’uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この秘密鍵を持つ人は、あなたのシステムにアクセスできる可能性があります。使用後はクリップボードを消去してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 개인 키를 가진 사람은 시스템에 접근할 수 있습니다. 사용 후 클립보드를 지우세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda osoba posiadająca ten klucz prywatny może uzyskać dostęp do Twoich systemów. Po użyciu wyczyść schowek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com esta chave privada pode acessar seus sistemas. Limpe a área de transferência após o uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何持有此私钥的人都可能访问您的系统。使用后请清空剪贴板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何持有此私鑰的人都可能存取您的系統。使用後請清除剪貼簿。"
          }
        }
      }
    },
