    "After granting access, reopen ToolPouch so macOS can apply the permission to the running app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ToolPouch nach der Freigabe erneut, damit macOS die Berechtigung auf die laufende App anwenden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras conceder el acceso, vuelve a abrir ToolPouch para que macOS aplique el permiso a la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir autorisé l’accès, rouvrez ToolPouch pour que macOS applique l’autorisation à l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver concesso l’accesso, riapri ToolPouch affinché macOS applichi il permesso all’app in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスを許可したらToolPouchを開き直し、実行中のアプリにmacOSが権限を適用できるようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한을 허용한 후 ToolPouch를 다시 열어 macOS가 실행 중인 앱에 권한을 적용하도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po przyznaniu dostępu otwórz aplikację ponownie, aby macOS zastosował uprawnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após conceder acesso, reabra o ToolPouch para que o macOS aplique a permissão ao app em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予权限后，请重新打开 ToolPouch，以便 macOS 将权限应用于运行中的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予權限後，請重新開啟 ToolPouch，讓 macOS 將權限套用至執行中的 App。"
          }
        }
      }
    },
