    "Use x, π, e, sin, cos, tan, sqrt, ln, log, abs, and exp. Implicit multiplication such as 2x is supported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende x, π, e, sin, cos, tan, sqrt, ln, log, abs und exp. Implizite Multiplikation wie 2x wird unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa x, π, e, sin, cos, tan, sqrt, ln, log, abs y exp. Se admite la multiplicación implícita, como 2x."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez x, π, e, sin, cos, tan, sqrt, ln, log, abs et exp. La multiplication implicite, comme 2x, est prise en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa x, π, e, sin, cos, tan, sqrt, ln, log, abs ed exp. È supportata la moltiplicazione implicita, ad esempio 2x."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x、π、e、sin、cos、tan、sqrt、ln、log、abs、expを使用できます。2xのような暗黙の乗算にも対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x, π, e, sin, cos, tan, sqrt, ln, log, abs 및 exp를 사용하세요. 2x와 같은 암시적 곱셈도 지원합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj x, π, e, sin, cos, tan, sqrt, ln, log, abs i exp. Obsługiwane jest też mnożenie domyślne, np. 2x."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
