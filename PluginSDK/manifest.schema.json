{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolpouch.app/schemas/plugin-manifest-v1.json",
  "title": "Toolpouch Plugin Manifest",
  "description": "Version 1 contract for a distributable .toolpouchplugin package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identifier",
    "displayName",
    "summary",
    "author",
    "version",
    "minimumHostVersion",
    "runtime",
    "supportedPlatforms",
    "permissions",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "identifier": {
      "$ref": "#/$defs/identifier"
    },
    "displayName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "minimumHostVersion": {
      "$ref": "#/$defs/version"
    },
    "runtime": {
      "enum": ["nativeProcess", "webAssembly", "remoteService"]
    },
    "entryPoint": {
      "type": "string",
      "pattern": "^payload/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$"
    },
    "serviceURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "supportedPlatforms": {
      "$ref": "#/$defs/platforms"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "files.user-selected.read",
          "files.user-selected.write",
          "network",
          "clipboard.read",
          "clipboard.write"
        ]
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "enum": ["nativeProcess", "webAssembly"]
          }
        }
      },
      "then": {
        "required": ["entryPoint"],
        "not": {
          "required": ["serviceURL"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "remoteService"
          }
        }
      },
      "then": {
        "required": ["serviceURL"],
        "not": {
          "required": ["entryPoint"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*){2,}$"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "patch"],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "patch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["macOS", "iOS", "watchOS"]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "screenCapture",
          "clipboard",
          "wiFiScanning",
          "sshKeys",
          "network",
          "rustEngine",
          "gridLayout"
        ]
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "categoryID",
        "title",
        "description",
        "systemImage",
        "supportedPlatforms",
        "requiredCapabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "categoryID": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "systemImage": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "supportedPlatforms": {
          "$ref": "#/$defs/platforms"
        },
        "requiredCapabilities": {
          "$ref": "#/$defs/capabilities"
        }
      }
    }
  }
}
